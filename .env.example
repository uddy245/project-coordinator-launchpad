# ==========================================================================
# .env.example — Project Coordinator Launchpad
# Copy to .env.local and fill in values. Never commit .env.local.
# ==========================================================================

# --------------------------------------------------------------------------
# Neon Postgres (project "pc-launchpad") — SERVER ONLY
# --------------------------------------------------------------------------
# Neon console → Connect. Pooled string for the app; unpooled (direct) for
# drizzle-kit introspection (`pnpm db:pull`) and one-off scripts.
# The database has NO row-level security: access control lives in server code.
DATABASE_URL=
DIRECT_URL=

# --------------------------------------------------------------------------
# Neon Auth (managed Better Auth)
# --------------------------------------------------------------------------
# Neon console → Auth → configuration: the Auth base URL, e.g.
# https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# Random string, >= 32 chars (signs the session cache cookie):
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --------------------------------------------------------------------------
# Neon Object Storage (S3-compatible, project pc-launchpad) — SERVER ONLY
# --------------------------------------------------------------------------
# Buckets (branch "production"): lesson-templates, lesson-videos (public_read);
# capstone-artifacts, submissions (private). Credentials: Neon console →
# branch → Credentials (scopes storage:read + storage:write), or
#   neon credentials create --scope storage:read --scope storage:write
# The secret is shown once. Set all four explicitly on Vercel.
AWS_ENDPOINT_URL_S3=https://br-misty-dream-av85gkim.storage.c-11.us-east-1.aws.neon.tech
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------------------------------
# Vercel Cron
# --------------------------------------------------------------------------
# Bearer secret Vercel sends to cron routes (/api/cron/tutor-retention).
CRON_SECRET=

# --------------------------------------------------------------------------
# Anthropic Claude API
# --------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Pinned model for grading. Bumping requires PR + regression against calibration corpus.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Daily cost cap in USD. Grading edge function refuses to run if day's spend exceeds.
ANTHROPIC_SPEND_CAP_USD=100

# --------------------------------------------------------------------------
# Stripe
# --------------------------------------------------------------------------
# Test keys during dev, live keys in Vercel prod env only.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret — different for local (stripe-cli forward) vs prod.
STRIPE_WEBHOOK_SECRET=

# Stripe Price ID for the $749 program purchase.
STRIPE_PRICE_ID=

# --------------------------------------------------------------------------
# Bunny Stream (video hosting)
# --------------------------------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# --------------------------------------------------------------------------
# ElevenLabs (lesson video narration — scripts/video/generate_audio.py)
# --------------------------------------------------------------------------
# Used only by the offline video-production pipeline, never by the app runtime.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --------------------------------------------------------------------------
# App URLs
# --------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --------------------------------------------------------------------------
# Email (transactional)
# --------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@launchpad.app
